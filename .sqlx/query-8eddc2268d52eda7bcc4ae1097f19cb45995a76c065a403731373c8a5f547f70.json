{
  "db_name": "MySQL",
  "query": "SELECT \n                o.id,\n                o.order_code,\n                t.name as customer_name,\n                o.order_status,\n                o.total_amount,\n                o.discount_amount,\n                o.actual_amount,\n                o.delivery_date,\n                o.delivery_address,\n                o.contact_name,\n                o.contact_phone,\n                o.remark,\n                o.created_by,\n                o.created_at,\n                o.confirmed_by,\n                o.confirmed_at,\n                o.processed_by,\n                o.processed_at,\n                o.stocked_by,\n                o.stocked_at,\n                o.after_sale_at,\n                o.rejected_by,\n                o.rejected_at,\n                o.reject_reason,\n                o.completed_by,\n                o.completed_at,\n                ds.name as delivery_staff_name,\n                ds.phone as delivery_staff_phone,\n                p.name as provider_name\n            FROM orders o \n            JOIN tenants t ON o.customer_id = t.id \n            LEFT JOIN delivery_staff ds ON o.delivery_staff_id = ds.id \n            LEFT JOIN provider_orders_assignments po ON o.id = po.order_id\n            LEFT JOIN tenants p ON po.provider_id = p.id\n            WHERE o.order_code = ?",
