  "query": "\n            SELECT DISTINCT o.customer_id, o.market_id, po.provider_id\n            FROM orders o\n            JOIN provider_orders_assignments po ON o.id = po.order_id\n            WHERE o.created_at BETWEEN ? AND ?\n            AND o.order_status = 'COMPLETED'\n            AND o.deleted_at IS NULL\n            ",
