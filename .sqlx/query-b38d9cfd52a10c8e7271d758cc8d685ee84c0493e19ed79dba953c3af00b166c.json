  "db_name": "MySQL",
  "query": "SELECT \n                re.order_detail_id,\n                o.order_code,\n                od.product_code,\n                od.product_name,\n                re.operation_type,\n                re.quantity,\n                re.reason,\n                od.unit,\n                re.evidence_images\n            FROM \n                return_exchange_records re\n            JOIN \n                order_details od ON re.order_detail_id = od.id\n            JOIN \n                orders o ON od.order_id = o.id\n            WHERE \n                o.order_code = ?\n            ORDER BY \n                re.created_at DESC",
